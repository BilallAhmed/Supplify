APP_NAME="Supplify"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=supplement_ecommerce
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Store checkout defaults (Phase 1 — flat shipping / simple tax)
# Pakistan market: set STORE_CURRENCY=PKR only after catalog prices are entered as PKR amounts.
# Do not treat existing USD preview placeholders as rupee prices without a commercial review.
STORE_CURRENCY=USD
STORE_SHIPPING_FLAT_CENTS=599
STORE_SHIPPING_FREE_OVER_CENTS=7500
STORE_TAX_RATE_PERCENT=0

# Storefront tracking (admin Settings → Tracking & Scripts can override environments)
# Comma-separated APP_ENV values that may receive GTM/GA4/Meta/custom snippets.
TRACKING_ENVIRONMENTS=production
TRACKING_FORCE_DISABLE=false
TRACKING_CONSENT_DAYS=365

# Payment gateway (provider TBC — client confirmation required)
PAYMENT_GATEWAY=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# AI assistant (provider/model TBC — client confirmation required)
# API usage costs are billed by the provider to the client — NOT included in development fee.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
